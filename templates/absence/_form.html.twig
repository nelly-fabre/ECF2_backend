{{ form_start(form) }}
    <div class="row">
        <div class="col-6 mb-3">
            {{ form_label(form.dateStart) }}
            {{ form_widget(form.dateStart, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.dateStart) }}
        </div>
        <div class="col-6 mb-3">
            {{ form_label(form.dateEnd) }}
            {{ form_widget(form.dateEnd, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.dateEnd) }}
        </div>
    </div>

    <div class="mb-3">
        {{ form_label(form.type) }}
        {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.type) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.student) }}
        {{ form_widget(form.student, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.student) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.documentFile) }}
        {{ form_widget(form.documentFile, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.documentFile) }}
    </div>

    <button class="btn btn-primary">Enregistrer</button>
{{ form_end(form) }}