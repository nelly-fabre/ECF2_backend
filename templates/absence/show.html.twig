{% extends 'base.html.twig' %}

{% block title %}Absence de {{ absence.student.firstName }} {{ absence.student.familyName }}{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 500px;">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">{{ absence.student.firstName }} {{ absence.student.familyName }}</h4>
            <p class="mb-1"><strong>Motif :</strong> {{ absence.type.name }}</p>
            <p class="mb-1"><strong>Du :</strong> {{ absence.dateStart|date('d/m/Y') }}</p>
            <p class="mb-1"><strong>Au :</strong> {{ absence.dateEnd|date('d/m/Y') }}</p>
            <p class="mb-0">
                <strong>Justificatif :</strong>
                {% if absence.document %}
                    <a href="{{ asset('uploads/documents/' ~ absence.document) }}" target="_blank">Voir le PDF</a>
                {% else %}
                    <span class="text-muted">Aucun</span>
                {% endif %}
            </p>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <a href="{{ path('app_absence_index') }}" class="btn btn-outline-secondary">← Retour</a>
            <a href="{{ path('app_absence_edit', {'id': absence.id}) }}" class="btn btn-primary">Modifier</a>
        </div>
    </div>
</div>
{% endblock %}