{% extends 'base.html.twig' %}

{% block title %}Absence index{% endblock %}

{% block body %}
    <h1>Absence index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateStart</th>
                <th>DateEnd</th>
                <th>Document</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for absence in absences %}
            <tr>
                <td>{{ absence.id }}</td>
                <td>{{ absence.dateStart ? absence.dateStart|date('Y-m-d') : '' }}</td>
                <td>{{ absence.dateEnd ? absence.dateEnd|date('Y-m-d') : '' }}</td>
                <td>{{ absence.document }}</td>
                <td>
                    <a href="{{ path('app_absence_show', {'id': absence.id}) }}">show</a>
                    <a href="{{ path('app_absence_edit', {'id': absence.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_absence_new') }}">Create new</a>
{% endblock %}
