{% extends 'base.html.twig' %}

{% block title %}Modifier {{ student.firstName }} {{ student.familyName }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">Modifier {{ student.firstName }} {{ student.familyName }}</h1>

    {{ include('student/_form.html.twig') }}

    <hr class="my-4">

    <form method="post" action="{{ path('app_student_delete', {'id': student.id}) }}"
          onsubmit="return confirm('Supprimer ce stagiaire ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ student.id) }}">
        <button class="btn btn-outline-danger">Supprimer ce stagiaire</button>
    </form>

    <a href="{{ path('app_student_index') }}" class="btn btn-link mt-3">← Retour à la liste</a>
</div>
{% endblock %}