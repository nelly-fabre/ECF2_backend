{% extends 'base.html.twig' %}

{% block title %}Liste des stagiaires{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Stagiaires</h1>
        <a href="{{ path('app_student_new') }}" class="btn btn-primary">Ajouter un stagiaire</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        {% for student in students %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    {% if student.picture %}
                        <img src="{{ asset('uploads/students/' ~ student.picture) }}"
                             class="card-img-top"
                             style="height: 200px; object-fit: cover;"
                             alt="Photo de {{ student.firstName }} {{ student.familyName }}">
                    {% else %}
                        <div class="card-img-top d-flex align-items-center justify-content-center bg-secondary text-white"
                             style="height: 200px;">
                            Pas de photo
                        </div>
                    {% endif %}

                    <div class="card-body">
                         {% if not student.active %}
                            <span class="badge bg-secondary mb-1">Archivé</span>
                        {% endif %}
                        <h5 class="card-title">{{ student.firstName }} {{ student.familyName }}</h5>
                        <p class="card-text text-muted">N° Afpa : {{ student.idAfpa }}</p>
                    </div>

                    <div class="card-footer d-flex justify-content-between bg-white p-2">
                        <a href="{{ path('app_student_show', {'id': student.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                        <a href="{{ path('app_student_edit', {'id': student.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>

                        {% if student.active %}
                            <form method="post" action="{{ path('app_student_delete', {'id': student.id}) }}"
                                    onsubmit="return confirm('Archiver ce stagiaire ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ student.id) }}">
                                <button class="btn btn-sm btn-outline-danger">Archiver</button>
                            </form>
                        {% else %}
                            <form method="post" action="{{ path('app_student_restore', {'id': student.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ student.id) }}">
                                <button class="btn btn-sm btn-outline-success">Réactiver</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun stagiaire enregistré.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}